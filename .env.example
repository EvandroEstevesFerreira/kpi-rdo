# Copie este arquivo para .env.local e preencha com os valores reais
# NUNCA commite o .env.local

# JWT da API do diariodeobra.app — enviado no header `Token`
# Capturar no DevTools do navegador (aba Network -> request headers -> Token)
# ou gerar em web.diariodeobra.app -> Configurações -> API (se disponível)
DIARIO_API_KEY=

# ID da empresa no diariodeobra.app — aparece na URL das chamadas:
# https://api.diariodeobra.app/v2/empresas/<EMPRESA_ID>/obras
# Sistenge: 654a833d61927fcb36089a85
DIARIO_EMPRESA_ID=654a833d61927fcb36089a85

# (Opcional) Sobrescreve a base URL da API. Default: https://api.diariodeobra.app/v2
# DIARIO_API_BASE=https://api.diariodeobra.app/v2

# Forçar dados simulados (true = mock, false = API real)
VITE_USE_MOCK=false

# Autenticação do dashboard (proteção por senha compartilhada)
# Gerar KPI_AUTH_SECRET com: openssl rand -hex 32  (ou qualquer string longa aleatoria)
KPI_AUTH_PASSWORD=
KPI_AUTH_SECRET=

# ── Notificação automática de aprovação (cron /api/notificar-aprovacoes) ──
# Chave da API do Resend (resend.com -> API Keys)
RESEND_API_KEY=
# Remetente. Precisa de dominio verificado no Resend p/ usar @sistenge.com.
# Enquanto nao verificar, pode usar: "RDO Sistenge <onboarding@resend.dev>"
NOTIFY_FROM=RDO Sistenge <rdo@sistenge.com>
# "true" para ENVIAR de verdade. Qualquer outro valor = dry-run (so loga).
NOTIFY_ENABLED=false
# Base do dashboard para o link no rodape do e-mail
NOTIFY_DASHBOARD_URL=https://kpi-rdo.vercel.app
# Protege o endpoint do cron. Gerar com: openssl rand -hex 32
# (o Vercel injeta automaticamente em execucoes de cron)
CRON_SECRET=
# Vercel KV (dedup) — criado no painel Vercel -> Storage -> KV.
# As duas variaveis abaixo sao injetadas automaticamente ao conectar o KV.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
